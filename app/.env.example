# Orb+ environment variables
# Copy this file to .env. Everything is optional: the app runs fully without it.

# Groq API key for AI answers in Orb Medical, beyond the onboard protocols.
# Get one at https://console.groq.com/keys
# Vite builds VITE_ variables into the JavaScript every visitor downloads, so anyone
# can read this key from the deployed site. Use it for local demos only.
VITE_GROQ_API_KEY=
