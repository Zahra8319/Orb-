# Orb+ Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key for AI Medical Advisor (optional - works offline without it)
# Get one at https://console.groq.com/keys
VITE_GROQ_API_KEY=

# NASA API Key for live space weather data (optional)
# Get one at https://api.nasa.gov/
VITE_NASA_API_KEY=

# Enable debug logging
VITE_DEBUG=false